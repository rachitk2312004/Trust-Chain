/// Phase D Step 1 — digital signature foundation

model Signature {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Human-readable public identifier (SIG-...).
  publicId         String    @unique @map("public_id")
  organizationId   String    @map("organization_id") @db.Uuid
  signerId         String    @map("signer_id") @db.Uuid
  documentId       String?   @map("document_id") @db.Uuid
  certificateId    String?   @map("certificate_id") @db.Uuid
  algorithm        String
  status           String    @default("active")
  /// PEM-encoded public key used for verification.
  publicKeyPem     String    @map("public_key_pem")
  /// Base64-encoded cryptographic signature over the canonical payload.
  signatureValue   String    @map("signature_value")
  /// SHA-256 of canonical payload bytes.
  payloadHash      String    @map("payload_hash")
  /// Integrity hash of the signature record fields.
  integrityHash    String    @map("integrity_hash")
  signedAt         DateTime  @map("signed_at") @db.Timestamptz(6)
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  metadataJson     Json?     @map("metadata_json")
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedById      String?   @map("revoked_by_id") @db.Uuid
  revokeReason     String?   @map("revoke_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  signer       User                 @relation("SignatureCreatedBy", fields: [signerId], references: [id], onDelete: Restrict)
  revokedBy    User?                @relation("SignatureRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  document     Document?            @relation(fields: [documentId], references: [id], onDelete: SetNull)
  certificate  Certificate?         @relation(fields: [certificateId], references: [id], onDelete: SetNull)
  events       SignatureEvent[]
  artifacts    SignatureArtifact[]
