generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Wave 1 identity & organization schema.
/// Column and table names preserve the existing PostgreSQL shape via @map / @@map.

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String
  passwordHash    String    @map("password_hash")
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  status          String    @default("active")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  devices                  Device[]
  sessions                 Session[]
  mfaFactors               MfaFactor[]
  emailTokens              EmailToken[]
  roleBindings             RoleBinding[]
  memberships              Membership[]
  membershipRequests       MembershipRequest[]       @relation("MembershipRequestUser")
  membershipRequestsReviewed MembershipRequest[]     @relation("MembershipRequestReviewer")
  invitationsSent          Invitation[]              @relation("InvitationInvitedBy")
  bulkImportJobs           BulkImportJob[]
  mfaLoginChallenges       MfaLoginChallenge[]
  certificateBulkJobsCreated CertificateBulkJob[] @relation("CertificateBulkJobCreatedBy")
  documentsCreated         Document[]                @relation("DocumentCreatedBy")
  documentVersionsUploaded DocumentVersion[]         @relation("DocumentVersionUploadedBy")
  documentSharesCreated    DocumentShare[]           @relation("DocumentShareCreatedBy")
  documentSharesReceived   DocumentShare[]           @relation("DocumentShareRecipient")
  documentAuditEntries     DocumentAuditEntry[]      @relation("DocumentAuditActor")
  documentUploadSessions   DocumentUploadSession[]   @relation("DocumentUploadSessionCreator")
  verificationRequests     VerificationRequest[]     @relation("VerificationRequestedBy")
  verificationAuditEntries VerificationAuditEntry[]  @relation("VerificationAuditActor")
  publicVerificationTokens PublicVerificationToken[] @relation("PublicTokenCreatedBy")
  publicVerificationLinks  PublicVerificationLink[]  @relation("PublicLinkCreatedBy")
  qrTemplatesCreated       QrTemplate[]              @relation("QrTemplateCreatedBy")
  documentQrCodesCreated   DocumentQrCode[]          @relation("DocumentQrCreatedBy")
  aiJobsCreated            AiJob[]                   @relation("AiJobCreatedBy")
  aiReviewsCompleted       AiHumanReview[]           @relation("AiReviewReviewer")
  opsAlertsCreated         OpsAlert[]                @relation("OpsAlertCreatedBy")
  opsReportsCreated        OpsReport[]               @relation("OpsReportCreatedBy")
  investigationsCreated    Investigation[]           @relation("InvestigationCreatedBy")
  policiesCreated          OpsPolicy[]               @relation("OpsPolicyCreatedBy")
  policyApprovals          PolicyApproval[]          @relation("PolicyApprovalActor")
  deploymentsCreated       DeploymentRecord[]        @relation("DeploymentCreatedBy")
  qrBatchJobsCreated       QrBatchJob[]              @relation("QrBatchCreatedBy")
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  notificationOutbox       NotificationOutbox[]
  certificateTemplatesCreated CertificateTemplate[] @relation("CertificateTemplateCreatedBy")
  certificatesIssued          Certificate[]         @relation("CertificateIssuedBy")
  certificatesRevoked         Certificate[]         @relation("CertificateRevokedBy")
  certificateEvents           CertificateEvent[]    @relation("CertificateEventActor")
  signaturesCreated           Signature[]           @relation("SignatureCreatedBy")
  signaturesRevoked           Signature[]           @relation("SignatureRevokedBy")
  signatureEvents             SignatureEvent[]      @relation("SignatureEventActor")
  signatureWorkflowsCreated   SignatureWorkflow[]   @relation("SignatureWorkflowCreatedBy")
  signatureWorkflowsCancelled SignatureWorkflow[]   @relation("SignatureWorkflowCancelledBy")
  signatureApprovals          SignatureApproval[]   @relation("SignatureApprovalReviewer")
  signatureApprovalEvents     SignatureApprovalEvent[] @relation("SignatureApprovalEventActor")
  adminAuditLogs              AdminAuditLog[]       @relation("AdminAuditActor")
  systemConfigurationsUpdated SystemConfiguration[] @relation("SystemConfigurationUpdatedBy")
  tenantQuotasUpdated         TenantQuota[]         @relation("TenantQuotaUpdatedBy")
  tenantLifecycleEvents       TenantLifecycleEvent[] @relation("TenantLifecycleActor")
  policyDefinitionsCreated    PolicyDefinition[]    @relation("PolicyDefinitionCreatedBy")
  policyAssignmentsCreated    PolicyAssignment[]    @relation("PolicyAssignmentCreatedBy")
  policyEvaluationEvents      PolicyEvaluationEvent[] @relation("PolicyEvaluationActor")
  serviceAccountsCreated      ServiceAccount[]      @relation("ServiceAccountCreatedBy")
  apiKeysCreated              ApiKey[]              @relation("ApiKeyCreatedBy")
  webhookEndpointsCreated     WebhookEndpoint[]     @relation("WebhookEndpointCreatedBy")
  developerApiQuotasUpdated   DeveloperApiQuota[]   @relation("DeveloperApiQuotaUpdatedBy")
  searchReindexesTriggered    SearchIndexJob[]      @relation("SearchIndexJobTriggeredBy")
  platformAuditEvents         PlatformAuditEvent[]  @relation("PlatformAuditActor")
  auditExportsTriggered       AuditExportJob[]      @relation("AuditExportJobTriggeredBy")
  complianceAssessmentsRun    ComplianceAssessment[] @relation("ComplianceAssessmentTriggeredBy")
  complianceRemediationsOwned ComplianceRemediation[] @relation("ComplianceRemediationOwner")
  complianceEvidenceCreated   ComplianceEvidence[]    @relation("ComplianceEvidenceCreatedBy")
  complianceEvidenceCustody   ComplianceEvidenceCustody[] @relation("ComplianceEvidenceCustodyActor")
  complianceEvidenceExports   ComplianceEvidenceExport[] @relation("ComplianceEvidenceExportTriggeredBy")
  retentionPoliciesCreated    RetentionPolicy[]       @relation("RetentionPolicyCreatedBy")
  legalHoldsCreated           LegalHold[]             @relation("LegalHoldCreatedBy")
  retentionRunsTriggered      RetentionRun[]          @relation("RetentionRunTriggeredBy")
  retentionCustody            RetentionCustodyEvent[] @relation("RetentionCustodyActor")
  enterpriseSamlUpdated       EnterpriseSamlConfig[]  @relation("EnterpriseSamlUpdatedBy")
  enterpriseScimUpdated       EnterpriseScimConfig[]  @relation("EnterpriseScimUpdatedBy")
  enterpriseRolesCreated      EnterpriseRole[]        @relation("EnterpriseRoleCreatedBy")
  enterpriseAbacCreated       EnterpriseAbacPolicy[]  @relation("EnterpriseAbacCreatedBy")
  enterpriseDelegatesGranted  EnterpriseDelegateAdmin[] @relation("EnterpriseDelegateGrantedBy")
  enterpriseDelegatesAsDelegate EnterpriseDelegateAdmin[] @relation("EnterpriseDelegateUser")
  enterpriseReviewsCreated    EnterpriseAccessReview[] @relation("EnterpriseAccessReviewCreatedBy")
  enterpriseReviewItems       EnterpriseAccessReviewItem[] @relation("EnterpriseAccessReviewSubject")
  orgDepartmentsOwned         Department[]            @relation("DepartmentOwner")
  orgBusinessUnitsOwned       OrgBusinessUnit[]       @relation("OrgBusinessUnitOwner")
  orgCostCentersOwned         OrgCostCenter[]         @relation("OrgCostCenterOwner")
  orgApprovalsCreated         OrgApprovalWorkflow[]   @relation("OrgApprovalCreatedBy")
  platformRegionsCreated      PlatformRegion[]        @relation("PlatformRegionCreatedBy")
  regionFailoversTriggered    RegionFailoverEvent[]   @relation("RegionFailoverTriggeredBy")
  recoveryPoliciesCreated     RecoveryBackupPolicy[]  @relation("RecoveryPolicyCreatedBy")
  recoveryBackupsTriggered    RecoveryBackupJob[]     @relation("RecoveryBackupTriggeredBy")
  recoveryRestoresTriggered   RecoveryRestoreJob[]    @relation("RecoveryRestoreTriggeredBy")
  recoveryFailbacksTriggered  RecoveryFailbackJob[]   @relation("RecoveryFailbackTriggeredBy")
  governancePoliciesOwned     GovernancePolicy[]      @relation("GovernancePolicyOwner")
  governancePoliciesCreated   GovernancePolicy[]      @relation("GovernancePolicyCreatedBy")
  governanceRisksOwned        GovernanceRisk[]        @relation("GovernanceRiskOwner")
  governanceRisksCreated      GovernanceRisk[]        @relation("GovernanceRiskCreatedBy")
  governanceAssessmentsOwned  GovernanceControlAssessment[] @relation("GovernanceAssessmentAssessor")
  walletLinks                 WalletLink[]            @relation("WalletLinkOwner")
  walletChallenges            WalletChallenge[]       @relation("WalletChallengeUser")
  walletSyncJobsTriggered     WalletSyncJob[]         @relation("WalletSyncTriggeredBy")
  walletOwnershipEvents       WalletOwnershipEvent[]  @relation("WalletOwnershipActor")
  integrationsCreated         EcosystemIntegration[]  @relation("IntegrationCreatedBy")
  integrationSyncJobsTriggered IntegrationSyncJob[]   @relation("IntegrationSyncTriggeredBy")
  integrationOAuthSessions    IntegrationOAuthSession[] @relation("IntegrationOAuthUser")
  marketplaceListingsPublished MarketplaceListing[]   @relation("MarketplaceListingPublisher")
  marketplaceInstalls         MarketplaceInstallation[] @relation("MarketplaceInstallActor")
  marketplaceReviews          MarketplaceReview[]     @relation("MarketplaceReviewAuthor")
  reputationProfilesUpdated   ReputationProfile[]     @relation("ReputationProfileUpdatedBy")
  reputationAlertsResolved    ReputationAlert[]       @relation("ReputationAlertResolver")
  platformConfigsUpdated      PlatformConfiguration[] @relation("PlatformConfigurationUpdatedBy")
  platformReadinessTriggered  PlatformReadinessReport[] @relation("PlatformReadinessTriggeredBy")

  @@index([email], map: "users_email_idx")
  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roleBindings RoleBinding[]

  @@map("roles")
}

model Organization {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  slug                 String
  parentOrganizationId String?  @map("parent_organization_id") @db.Uuid
  status               String   @default("active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent                      Organization?                   @relation("OrgHierarchy", fields: [parentOrganizationId], references: [id], onDelete: SetNull)
  children                    Organization[]                  @relation("OrgHierarchy")
  branches                    Branch[]
  departments                 Department[]
  memberships                 Membership[]
  membershipRequests          MembershipRequest[]
  invitations                 Invitation[]
  roleBindings                RoleBinding[]
  branding                    OrganizationBranding?
  bulkImports                 BulkImportJob[]
  documents                   Document[]
  documentCategories          DocumentCategory[]
  documentTags                DocumentTag[]
  documentAuditEntries        DocumentAuditEntry[]
  documentUploadSessions      DocumentUploadSession[]
  blockchainTransactions      BlockchainTransaction[]
  blockchainAnchors           BlockchainAnchor[]
  blockchainRetryJobs         BlockchainRetryJob[]
  chainRegistrations          OrganizationChainRegistration[]
  chainIntentNonces           BlockchainIntentNonce[]
  verificationRequests        VerificationRequest[]
  verificationResults         VerificationResult[]
  verificationAuditEntries    VerificationAuditEntry[]
  verificationCaches          VerificationCache[]
  publicVerificationTokens    PublicVerificationToken[]
  publicVerificationLinks     PublicVerificationLink[]
  publicVerificationEvents    PublicVerificationEvent[]
  publicVerificationAnalytics PublicVerificationAnalytics[]
  publicAbuseBlocks           PublicAbuseBlock[]
  qrTemplates                 QrTemplate[]
  documentQrCodes             DocumentQrCode[]
  qrVerificationEvents        QrVerificationEvent[]
  qrAnalytics                 QrAnalytics[]
  qrBatchJobs                 QrBatchJob[]
  aiJobs                      AiJob[]
  ocrJobs                     OcrJob[]
  classificationJobs          ClassificationJob[]
  embeddingJobs               EmbeddingJob[]
  fraudAnalysisJobs           FraudAnalysisJob[]
  aiLineages                  AiLineage[]
  aiAuditEvents               AiAuditEvent[]
  documentEmbeddings          DocumentEmbedding[]
  aiQueues                    AiQueue[]
  aiWorkers                   AiWorker[]
  aiTasks                     AiTask[]
  aiArtifacts                 AiArtifact[]
  aiModels                    AiModel[]
  aiEvaluations               AiEvaluation[]
  aiCostRecords               AiCostRecord[]
  opsAlerts                   OpsAlert[]
  opsReports                  OpsReport[]
  investigations              Investigation[]
  evidenceItems               Evidence[]
  opsPolicies                 OpsPolicy[]
  subscriptions               Subscription[]
  invoices                    Invoice[]
  usageMetrics                UsageMetric[]
  featureFlags                FeatureFlag[]
  complianceEvents            ComplianceEvent[]
  opsAuditEvents              OpsAuditEvent[]
  healthSnapshots             HealthSnapshot[]
  platformScores              PlatformScore[]
  deploymentRecords           DeploymentRecord[]
  recoveryBackups             RecoveryBackup[]
  capacitySnapshots           CapacitySnapshot[]
  dataCatalogEntries          DataCatalogEntry[]
  serviceRegistryEntries      ServiceRegistryEntry[]
  secretAuditEvents           SecretAuditEvent[]
  platformEvents              PlatformEvent[]
  notifications               Notification[]
  notificationPreferences     NotificationPreference[]
  notificationOutbox          NotificationOutbox[]
  certificateTemplates        CertificateTemplate[]
  certificates                Certificate[]
  certificateEvents           CertificateEvent[]
  certificateBulkJobs         CertificateBulkJob[]
  signatures                  Signature[]
  signatureEvents             SignatureEvent[]
  signatureArtifacts          SignatureArtifact[]
  signatureWorkflows          SignatureWorkflow[]
  signatureApprovals          SignatureApproval[]
  signatureApprovalEvents     SignatureApprovalEvent[]
  tenantQuota                 TenantQuota?
  tenantLifecycleEvents       TenantLifecycleEvent[]
  policyAssignments           PolicyAssignment[]
  policyEvaluationEvents      PolicyEvaluationEvent[]
  serviceAccounts             ServiceAccount[]
  apiKeys                     ApiKey[]
  webhookEndpoints            WebhookEndpoint[]
  webhookDeliveries           WebhookDelivery[]
  apiUsageEvents              ApiUsageEvent[]
  apiIdempotencyRecords       ApiIdempotencyRecord[]
  developerApiQuota           DeveloperApiQuota?
  searchIndexEntries          SearchIndexEntry[]
  searchIndexJobs             SearchIndexJob[]
  platformAuditEvents         PlatformAuditEvent[]
  auditExportJobs             AuditExportJob[]
  complianceAssessments       ComplianceAssessment[]
  complianceViolations        ComplianceViolation[]
  complianceRemediations      ComplianceRemediation[]
  complianceReports           ComplianceReport[]
  complianceEvidence          ComplianceEvidence[]
  complianceEvidenceExports   ComplianceEvidenceExport[]
  retentionPolicies           RetentionPolicy[]
  legalHolds                  LegalHold[]
  retentionRuns               RetentionRun[]
  retentionArchives           RetentionArchive[]
  retentionCustodyEvents      RetentionCustodyEvent[]
  enterpriseSamlConfig        EnterpriseSamlConfig?
  enterpriseScimConfig        EnterpriseScimConfig?
  enterpriseRoles             EnterpriseRole[]
  enterpriseAbacPolicies      EnterpriseAbacPolicy[]
  enterpriseDelegates         EnterpriseDelegateAdmin[]
  enterpriseAccessReviews     EnterpriseAccessReview[]
  orgBusinessUnits             OrgBusinessUnit[]
  orgCostCenters              OrgCostCenter[]
  orgApprovalWorkflows        OrgApprovalWorkflow[]
  orgResidencyPolicy          OrgResidencyPolicy?
  orgRoutingPolicy            OrgRoutingPolicy?
  orgReplicationPolicy        OrgReplicationPolicy?
  orgFailoverPolicy           OrgFailoverPolicy?
  regionFailoverEvents        RegionFailoverEvent[]
  recoveryBackupPolicies      RecoveryBackupPolicy[]
  recoveryBackupJobs          RecoveryBackupJob[]
  recoveryRestoreJobs         RecoveryRestoreJob[]
  recoveryFailbackJobs        RecoveryFailbackJob[]
  recoveryReports             RecoveryContinuityReport[]
  governancePolicies          GovernancePolicy[]
  governanceRisks             GovernanceRisk[]
  governanceAssessments       GovernanceControlAssessment[]
  governanceReports           GovernanceExecutiveReport[]
  walletLinks                 WalletLink[]
  walletChallenges            WalletChallenge[]
  walletSyncJobs              WalletSyncJob[]
  walletOwnershipEvents       WalletOwnershipEvent[]
  ecosystemIntegrations       EcosystemIntegration[]
  integrationCredentials      IntegrationCredential[]
  integrationOAuthSessions    IntegrationOAuthSession[]
  integrationSyncJobs         IntegrationSyncJob[]
  integrationSubscriptions    IntegrationEventSubscription[]
  integrationEvents           IntegrationEventLog[]
  marketplaceListings         MarketplaceListing[]    @relation("MarketplaceListingPublisherOrg")
  marketplaceInstallations    MarketplaceInstallation[]
  marketplaceReviews          MarketplaceReview[]
  reputationProfiles          ReputationProfile[]
  reputationHistory           ReputationHistoryEvent[]
  reputationAlerts            ReputationAlert[]

  @@unique([slug], map: "organizations_slug_unique_idx")
  @@index([slug], map: "organizations_slug_idx")
  @@index([parentOrganizationId], map: "organizations_parent_idx")
  @@map("organizations")
}

model Device {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String?
  fingerprint String?
  userAgent   String?   @map("user_agent")
  trusted     Boolean   @default(false)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([userId], map: "devices_user_id_idx")
  @@map("devices")
}

model Session {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  deviceId         String?              @map("device_id") @db.Uuid
  refreshTokenHash String               @map("refresh_token_hash")
  ip               Unsupported("inet")?
  userAgent        String?              @map("user_agent")
  expiresAt        DateTime             @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?            @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId], map: "sessions_user_id_idx")
  @@index([refreshTokenHash], map: "sessions_refresh_token_hash_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model MfaFactor {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  type            String    @default("totp")
  secretEncrypted String    @map("secret_encrypted")
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz(6)
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "mfa_factors_user_id_idx")
  @@map("mfa_factors")
}

model MfaLoginChallenge {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash], map: "mfa_login_challenges_token_hash_idx")
  @@index([userId], map: "mfa_login_challenges_user_id_idx")
  @@map("mfa_login_challenges")
}

model EmailToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  purpose   String
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash], map: "email_tokens_token_hash_idx")
  @@index([userId], map: "email_tokens_user_id_idx")
  @@map("email_tokens")
}

model RoleBinding {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId])
  @@index([userId], map: "role_bindings_user_id_idx")
  @@index([organizationId], map: "role_bindings_organization_id_idx")
  @@map("role_bindings")
}

model Branch {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  code           String?
  addressLine1   String?  @map("address_line1")
  addressLine2   String?  @map("address_line2")
  city           String?
  region         String?
  postalCode     String?  @map("postal_code")
  country        String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments  Department[]
  memberships  Membership[]
  invitations  Invitation[]

  @@index([organizationId], map: "branches_organization_id_idx")
  @@map("branches")
}

model Department {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  branchId            String?  @map("branch_id") @db.Uuid
  name                String
  code                String?
  /// Phase H Step 2 — hierarchy + ownership + cost allocation
  parentDepartmentId  String?  @map("parent_department_id") @db.Uuid
  businessUnitId      String?  @map("business_unit_id") @db.Uuid
  costCenterId        String?  @map("cost_center_id") @db.Uuid
  ownerUserId         String?  @map("owner_user_id") @db.Uuid
  /// Local policy overlays inherited from ancestors
  policyJson          Json     @default("{}") @map("policy_json")
  status              String   @default("active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch           Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  parentDepartment Department?     @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments Department[]    @relation("DepartmentHierarchy")
  businessUnit     OrgBusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  costCenter       OrgCostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  owner            User?           @relation("DepartmentOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  memberships      Membership[]
  invitations      Invitation[]

  @@index([organizationId], map: "departments_organization_id_idx")
  @@index([branchId], map: "departments_branch_id_idx")
  @@index([parentDepartmentId], map: "departments_parent_idx")
  @@index([businessUnitId], map: "departments_business_unit_idx")
  @@map("departments")
}

model Membership {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  departmentId   String?  @map("department_id") @db.Uuid
  title          String?
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId], map: "memberships_organization_id_idx")
  @@index([userId], map: "memberships_user_id_idx")
  @@map("memberships")
}

model Invitation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  roleKey        String    @map("role_key")
  tokenHash      String    @map("token_hash")
  invitedBy      String?   @map("invited_by") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  departmentId   String?   @map("department_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User?        @relation("InvitationInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([email], map: "invitations_email_idx")
  @@index([organizationId], map: "invitations_organization_id_idx")
  @@index([tokenHash], map: "invitations_token_hash_idx")
  @@map("invitations")
}

model MembershipRequest {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  message        String?
  requestedRole  String    @default("employee") @map("requested_role")
  status         String    @default("pending")
  reviewedBy     String?   @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNote     String?   @map("review_note")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("MembershipRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewer     User?        @relation("MembershipRequestReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([organizationId, status], map: "membership_requests_organization_id_status_idx")
  @@index([userId], map: "membership_requests_user_id_idx")
  @@map("membership_requests")
}

model OrganizationBranding {
  organizationId String   @id @map("organization_id") @db.Uuid
  displayName    String?  @map("display_name")
  logoObjectKey  String?  @map("logo_object_key")
  primaryColor   String?  @map("primary_color")
  secondaryColor String?  @map("secondary_color")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_branding")
}

model BulkImportJob {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  createdBy            String?   @map("created_by") @db.Uuid
  sourceObjectKey      String    @map("source_object_key")
  errorReportObjectKey String?   @map("error_report_object_key")
  status               String    @default("pending")
  totalRows            Int       @default(0) @map("total_rows")
  successRows          Int       @default(0) @map("success_rows")
  failedRows           Int       @default(0) @map("failed_rows")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([organizationId], map: "bulk_import_jobs_organization_id_idx")
  @@map("bulk_import_jobs")
}

/// Wave 2 — Document management

model Document {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  createdById      String    @map("created_by_id") @db.Uuid
  title            String
  description      String?
  categoryId       String?   @map("category_id") @db.Uuid
  currentVersionId String?   @unique @map("current_version_id") @db.Uuid
  status           String    @default("pending_upload")
  /// private | organization | public | restricted
  visibility       String    @default("private")
  publicVerifyCode String?   @unique @map("public_verify_code")
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization                Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy                   User                          @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  category                    DocumentCategory?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  currentVersion              DocumentVersion?              @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions                    DocumentVersion[]             @relation("DocumentVersions")
  tags                        DocumentTagOnDocument[]
  shares                      DocumentShare[]
  accessPolicies              DocumentAccessPolicy[]
  auditEntries                DocumentAuditEntry[]
  uploadSessions              DocumentUploadSession[]
  blockchainTransactions      BlockchainTransaction[]
  blockchainAnchors           BlockchainAnchor[]
  verificationRequests        VerificationRequest[]
  verificationCaches          VerificationCache[]
  publicVerificationTokens    PublicVerificationToken[]
  publicVerificationLinks     PublicVerificationLink[]
  publicVerificationEvents    PublicVerificationEvent[]
  publicVerificationAnalytics PublicVerificationAnalytics[]
  documentQrCodes             DocumentQrCode[]
  qrVerificationEvents        QrVerificationEvent[]
  qrAnalytics                 QrAnalytics[]
  aiJobs                      AiJob[]
  ocrJobs                     OcrJob[]
  classificationJobs          ClassificationJob[]
  embeddingJobs               EmbeddingJob[]
  fraudAnalysisJobs           FraudAnalysisJob[]
  aiLineages                  AiLineage[]
  documentEmbeddings          DocumentEmbedding[]
  aiTasks                     AiTask[]
  aiArtifacts                 AiArtifact[]
  certificates                Certificate[]
  signatures                  Signature[]

  @@index([organizationId], map: "documents_organization_id_idx")
  @@index([status], map: "documents_status_idx")
  @@index([visibility], map: "documents_visibility_idx")
  @@index([publicVerifyCode], map: "documents_public_verify_code_idx")
  @@index([deletedAt], map: "documents_deleted_at_idx")
  @@index([expiresAt], map: "documents_expires_at_idx")
  @@map("documents")
}

model DocumentVersion {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId          String   @map("document_id") @db.Uuid
  versionNumber       Int      @map("version_number")
  objectKey           String   @map("object_key")
  contentHash         String   @map("content_hash")
  mimeType            String   @map("mime_type")
  sizeBytes           BigInt   @map("size_bytes")
  originalFileName    String   @map("original_file_name")
  uploadedById        String   @map("uploaded_by_id") @db.Uuid
  checksumAlgorithm   String   @default("sha256") @map("checksum_algorithm")
  encrypted           Boolean  @default(false)
  encryptionAlgorithm String?  @map("encryption_algorithm")
  keyVersion          Int?     @map("key_version")
  wrappedDek          String?  @map("wrapped_dek")
  iv                  String?
  authTag             String?  @map("auth_tag")
  encryptionMetadata  Json?    @map("encryption_metadata")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document               Document                @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy             User                    @relation("DocumentVersionUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  currentFor             Document?               @relation("DocumentCurrentVersion")
  blockchainTransactions BlockchainTransaction[]
  blockchainAnchors      BlockchainAnchor[]
  verificationRequests   VerificationRequest[]

  @@unique([documentId, versionNumber], map: "document_versions_document_id_version_number_key")
  @@index([documentId], map: "document_versions_document_id_idx")
  @@index([contentHash], map: "document_versions_content_hash_idx")
  @@map("document_versions")
}

model DocumentCategory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    Document[]

  @@unique([organizationId, name], map: "document_categories_organization_id_name_key")
  @@index([organizationId], map: "document_categories_organization_id_idx")
  @@map("document_categories")
}

model DocumentTag {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    DocumentTagOnDocument[]

  @@unique([organizationId, name], map: "document_tags_organization_id_name_key")
  @@index([organizationId], map: "document_tags_organization_id_idx")
  @@map("document_tags")
}

model DocumentTagOnDocument {
  documentId String @map("document_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  document Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag      DocumentTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@map("document_tags_on_documents")
}

model DocumentShare {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId       String    @map("document_id") @db.Uuid
  sharedWithUserId String?   @map("shared_with_user_id") @db.Uuid
  sharedWithEmail  String?   @map("shared_with_email")
  permission       String
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdById      String    @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sharedWithUser User?    @relation("DocumentShareRecipient", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  createdBy      User     @relation("DocumentShareCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([documentId], map: "document_shares_document_id_idx")
  @@map("document_shares")
}

model DocumentAccessPolicy {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id")
  permission  String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, subjectType, subjectId, permission], map: "document_access_policies_unique")
  @@index([documentId], map: "document_access_policies_document_id_idx")
  @@map("document_access_policies")
}

model DocumentAuditEntry {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("DocumentAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([documentId], map: "document_audit_entries_document_id_idx")
  @@index([organizationId, createdAt], map: "document_audit_entries_organization_id_created_at_idx")
  @@map("document_audit_entries")
}

model DocumentUploadSession {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId        String    @map("document_id") @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  createdById       String    @map("created_by_id") @db.Uuid
  objectKey         String    @map("object_key")
  expectedMimeType  String    @map("expected_mime_type")
  expectedSizeBytes BigInt?   @map("expected_size_bytes")
  status            String    @default("pending")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("DocumentUploadSessionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([documentId], map: "document_upload_sessions_document_id_idx")
  @@index([organizationId], map: "document_upload_sessions_organization_id_idx")
  @@index([status], map: "document_upload_sessions_status_idx")
  @@index([expiresAt], map: "document_upload_sessions_expires_at_idx")
  @@map("document_upload_sessions")
}

/// Wave 3 — Blockchain integration (Hardhat + Sepolia only)

model BlockchainNetwork {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                     String   @unique
  chainId                 Int      @map("chain_id")
  name                    String
  rpcUrlHint              String?  @map("rpc_url_hint")
  explorerBaseUrl         String?  @map("explorer_base_url")
  documentRegistryAddress String?  @map("document_registry_address")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  transactions     BlockchainTransaction[]
  anchors          BlockchainAnchor[]
  events           BlockchainEvent[]
  retryJobs        BlockchainRetryJob[]
  orgRegistrations OrganizationChainRegistration[]
  intentNonces     BlockchainIntentNonce[]

  @@index([chainId], map: "blockchain_networks_chain_id_idx")
  @@map("blockchain_networks")
}

model BlockchainTransaction {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  networkId         String    @map("network_id") @db.Uuid
  organizationId    String?   @map("organization_id") @db.Uuid
  documentId        String?   @map("document_id") @db.Uuid
  documentVersionId String?   @map("document_version_id") @db.Uuid
  operation         String
  fromAddress       String    @map("from_address")
  toAddress         String    @map("to_address")
  nonce             Int?
  txHash            String?   @map("tx_hash")
  status            String    @default("pending")
  blockNumber       BigInt?   @map("block_number")
  blockHash         String?   @map("block_hash")
  transactionIndex  Int?      @map("transaction_index")
  confirmationCount Int       @default(0) @map("confirmation_count")
  gasLimit          BigInt?   @map("gas_limit")
  gasUsed           BigInt?   @map("gas_used")
  maxFeePerGas      BigInt?   @map("max_fee_per_gas")
  error             String?
  submittedAt       DateTime? @map("submitted_at") @db.Timestamptz(6)
  confirmedAt       DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  network          BlockchainNetwork               @relation(fields: [networkId], references: [id], onDelete: Cascade)
  organization     Organization?                   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  document         Document?                       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentVersion  DocumentVersion?                @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  anchorsAsAnchor  BlockchainAnchor[]              @relation("AnchorTx")
  anchorsAsRevoke  BlockchainAnchor[]              @relation("RevokeTx")
  orgRegistrations OrganizationChainRegistration[]

  @@unique([networkId, txHash], map: "blockchain_transactions_network_id_tx_hash_key")
  @@index([status], map: "blockchain_transactions_status_idx")
  @@index([organizationId], map: "blockchain_transactions_organization_id_idx")
  @@index([documentId], map: "blockchain_transactions_document_id_idx")
  @@map("blockchain_transactions")
}

model BlockchainAnchor {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  networkId         String    @map("network_id") @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  documentId        String    @map("document_id") @db.Uuid
  documentVersionId String    @map("document_version_id") @db.Uuid
  contentHash       String    @map("content_hash")
  versionNumber     Int       @map("version_number")
  orgIdBytes32      String    @map("org_id_bytes32")
  documentIdBytes32 String    @map("document_id_bytes32")
  status            String    @default("pending")
  blockNumber       BigInt?   @map("block_number")
  blockHash         String?   @map("block_hash")
  transactionIndex  Int?      @map("transaction_index")
  confirmationCount Int       @default(0) @map("confirmation_count")
  anchoredAt        DateTime? @map("anchored_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  failedAt          DateTime? @map("failed_at") @db.Timestamptz(6)
  failureReason     String?   @map("failure_reason")
  anchorTxId        String?   @map("anchor_tx_id") @db.Uuid
  revokeTxId        String?   @map("revoke_tx_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  network         BlockchainNetwork      @relation(fields: [networkId], references: [id], onDelete: Cascade)
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document        Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion        @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  anchorTx        BlockchainTransaction? @relation("AnchorTx", fields: [anchorTxId], references: [id], onDelete: SetNull)
  revokeTx        BlockchainTransaction? @relation("RevokeTx", fields: [revokeTxId], references: [id], onDelete: SetNull)

  @@unique([networkId, documentVersionId], map: "blockchain_anchors_network_id_document_version_id_key")
  @@index([contentHash], map: "blockchain_anchors_content_hash_idx")
  @@index([organizationId], map: "blockchain_anchors_organization_id_idx")
  @@index([status], map: "blockchain_anchors_status_idx")
  @@map("blockchain_anchors")
}

model BlockchainEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  networkId       String   @map("network_id") @db.Uuid
  contractAddress String   @map("contract_address")
  eventName       String   @map("event_name")
  blockNumber     BigInt   @map("block_number")
  logIndex        Int      @map("log_index")
  txHash          String   @map("tx_hash")
  payload         Json?
  processedAt     DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  network BlockchainNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@unique([networkId, txHash, logIndex], map: "blockchain_events_network_id_tx_hash_log_index_key")
  @@index([networkId, eventName], map: "blockchain_events_network_id_event_name_idx")
  @@map("blockchain_events")
}

model BlockchainRetryJob {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  networkId      String    @map("network_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  operation      String
  referenceType  String    @map("reference_type")
  referenceId    String    @map("reference_id") @db.Uuid
  payload        Json?
  status         String    @default("queued")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(8) @map("max_attempts")
  lastError      String?   @map("last_error")
  nextRunAt      DateTime  @default(now()) @map("next_run_at") @db.Timestamptz(6)
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  network      BlockchainNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)
  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status, nextRunAt], map: "blockchain_retry_jobs_status_next_run_at_idx")
  @@index([organizationId], map: "blockchain_retry_jobs_organization_id_idx")
  @@map("blockchain_retry_jobs")
}

model OrganizationChainRegistration {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  networkId      String    @map("network_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  ownerAddress   String    @map("owner_address")
  status         String    @default("pending")
  registerTxId   String?   @map("register_tx_id") @db.Uuid
  registeredAt   DateTime? @map("registered_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  network      BlockchainNetwork      @relation(fields: [networkId], references: [id], onDelete: Cascade)
  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registerTx   BlockchainTransaction? @relation(fields: [registerTxId], references: [id], onDelete: SetNull)

  @@unique([networkId, organizationId], map: "organization_chain_registrations_network_id_organization_id_key")
  @@map("organization_chain_registrations")
}

model BlockchainIntentNonce {
  organizationId String   @map("organization_id") @db.Uuid
  networkId      String   @map("network_id") @db.Uuid
  nextNonce      BigInt   @default(0) @map("next_nonce")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  network      BlockchainNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@id([organizationId, networkId])
  @@map("blockchain_intent_nonces")
}

/// Wave 4 — Verification engine

model VerificationRequest {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  verificationCode    String    @unique @map("verification_code")
  organizationId      String    @map("organization_id") @db.Uuid
  documentId          String    @map("document_id") @db.Uuid
  documentVersionId   String?   @map("document_version_id") @db.Uuid
  requestedByUserId   String    @map("requested_by_user_id") @db.Uuid
  mode                String    @default("sync")
  /// Internal: pending | processing | completed | failed
  status              String    @default("pending")
  idempotencyKey      String?   @map("idempotency_key")
  expectedContentHash String?   @map("expected_content_hash")
  options             Json?
  intentNonce         BigInt?   @map("intent_nonce")
  signature           String?
  startedAt           DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document        Document                 @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion?         @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  requestedBy     User                     @relation("VerificationRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  result          VerificationResult?
  auditEntries    VerificationAuditEntry[]
  caches          VerificationCache[]

  @@unique([organizationId, idempotencyKey], map: "verification_requests_organization_id_idempotency_key_key")
  @@index([organizationId, createdAt], map: "verification_requests_organization_id_created_at_idx")
  @@index([documentId, createdAt], map: "verification_requests_document_id_created_at_idx")
  @@index([status], map: "verification_requests_status_idx")
  @@index([verificationCode], map: "verification_requests_verification_code_idx")
  @@map("verification_requests")
}

model VerificationResult {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId        String    @unique @map("request_id") @db.Uuid
