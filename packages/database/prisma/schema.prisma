/// Phase D Step 4 — multi-party approval workflows

model SignatureWorkflow {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Human-readable public identifier (WF-...).
  publicId         String    @unique @map("public_id")
  organizationId   String    @map("organization_id") @db.Uuid
  signatureId      String?   @map("signature_id") @db.Uuid
  createdById      String    @map("created_by_id") @db.Uuid
  title            String
  description      String?
  /// sequential | parallel | threshold
  workflowType     String    @map("workflow_type")
  /// pending | approved | rejected | cancelled | expired
  status           String    @default("pending")
  /// Required approvals for threshold workflows.
  thresholdCount   Int?      @map("threshold_count")
  /// Active step for sequential workflows (1-based).
  currentStep      Int       @default(1) @map("current_step")
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledById    String?   @map("cancelled_by_id") @db.Uuid
  cancelReason     String?   @map("cancel_reason")
  metadataJson     Json?     @map("metadata_json")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  signature    Signature?              @relation(fields: [signatureId], references: [id], onDelete: SetNull)
  createdBy    User                    @relation("SignatureWorkflowCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy  User?                   @relation("SignatureWorkflowCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  approvals    SignatureApproval[]
  events       SignatureApprovalEvent[]

  @@index([organizationId, createdAt], map: "signature_workflows_org_created_at_idx")
  @@index([organizationId, status], map: "signature_workflows_org_status_idx")
  @@index([signatureId], map: "signature_workflows_signature_id_idx")
  @@index([createdById], map: "signature_workflows_created_by_id_idx")
  @@map("signature_workflows")
}

model SignatureApproval {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
