generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Wave 1 identity & organization schema.
/// Column and table names preserve the existing PostgreSQL shape via @map / @@map.

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String
  passwordHash    String    @map("password_hash")
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  status          String    @default("active")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  devices                  Device[]
  sessions                 Session[]
  mfaFactors               MfaFactor[]
  emailTokens              EmailToken[]
  roleBindings             RoleBinding[]
  memberships              Membership[]
  invitationsSent          Invitation[]              @relation("InvitationInvitedBy")
  bulkImportJobs           BulkImportJob[]
  mfaLoginChallenges       MfaLoginChallenge[]
  documentsCreated         Document[]                @relation("DocumentCreatedBy")
  documentVersionsUploaded DocumentVersion[]         @relation("DocumentVersionUploadedBy")
  documentSharesCreated    DocumentShare[]           @relation("DocumentShareCreatedBy")
  documentSharesReceived   DocumentShare[]           @relation("DocumentShareRecipient")
  documentAuditEntries     DocumentAuditEntry[]      @relation("DocumentAuditActor")
  documentUploadSessions   DocumentUploadSession[]   @relation("DocumentUploadSessionCreator")
  verificationRequests     VerificationRequest[]     @relation("VerificationRequestedBy")
  verificationAuditEntries VerificationAuditEntry[]  @relation("VerificationAuditActor")
  publicVerificationTokens PublicVerificationToken[] @relation("PublicTokenCreatedBy")
  publicVerificationLinks  PublicVerificationLink[]  @relation("PublicLinkCreatedBy")
  qrTemplatesCreated       QrTemplate[]              @relation("QrTemplateCreatedBy")
  documentQrCodesCreated   DocumentQrCode[]          @relation("DocumentQrCreatedBy")

  @@index([email], map: "users_email_idx")
  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roleBindings RoleBinding[]

  @@map("roles")
}

model Organization {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  slug                 String
  parentOrganizationId String?  @map("parent_organization_id") @db.Uuid
  status               String   @default("active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent                      Organization?                   @relation("OrgHierarchy", fields: [parentOrganizationId], references: [id], onDelete: SetNull)
  children                    Organization[]                  @relation("OrgHierarchy")
  branches                    Branch[]
  departments                 Department[]
  memberships                 Membership[]
  invitations                 Invitation[]
  roleBindings                RoleBinding[]
  branding                    OrganizationBranding?
  bulkImports                 BulkImportJob[]
  documents                   Document[]
  documentCategories          DocumentCategory[]
  documentTags                DocumentTag[]
  documentAuditEntries        DocumentAuditEntry[]
  documentUploadSessions      DocumentUploadSession[]
  blockchainTransactions      BlockchainTransaction[]
  blockchainAnchors           BlockchainAnchor[]
  blockchainRetryJobs         BlockchainRetryJob[]
  chainRegistrations          OrganizationChainRegistration[]
  chainIntentNonces           BlockchainIntentNonce[]
  verificationRequests        VerificationRequest[]
  verificationResults         VerificationResult[]
  verificationAuditEntries    VerificationAuditEntry[]
  verificationCaches          VerificationCache[]
  publicVerificationTokens    PublicVerificationToken[]
  publicVerificationLinks     PublicVerificationLink[]
  publicVerificationEvents    PublicVerificationEvent[]
  publicVerificationAnalytics PublicVerificationAnalytics[]
  publicAbuseBlocks           PublicAbuseBlock[]
  qrTemplates                 QrTemplate[]
  documentQrCodes             DocumentQrCode[]
  qrVerificationEvents        QrVerificationEvent[]
  qrAnalytics                 QrAnalytics[]

  @@unique([slug], map: "organizations_slug_unique_idx")
  @@index([slug], map: "organizations_slug_idx")
  @@index([parentOrganizationId], map: "organizations_parent_idx")
  @@map("organizations")
}

model Device {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String?
  fingerprint String?
  userAgent   String?   @map("user_agent")
  trusted     Boolean   @default(false)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([userId], map: "devices_user_id_idx")
  @@map("devices")
}

model Session {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  deviceId         String?              @map("device_id") @db.Uuid
  refreshTokenHash String               @map("refresh_token_hash")
  ip               Unsupported("inet")?
  userAgent        String?              @map("user_agent")
  expiresAt        DateTime             @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?            @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId], map: "sessions_user_id_idx")
  @@index([refreshTokenHash], map: "sessions_refresh_token_hash_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model MfaFactor {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  type            String    @default("totp")
  secretEncrypted String    @map("secret_encrypted")
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz(6)
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "mfa_factors_user_id_idx")
  @@map("mfa_factors")
}

model MfaLoginChallenge {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash], map: "mfa_login_challenges_token_hash_idx")
  @@index([userId], map: "mfa_login_challenges_user_id_idx")
  @@map("mfa_login_challenges")
}

model EmailToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  purpose   String
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash], map: "email_tokens_token_hash_idx")
  @@index([userId], map: "email_tokens_user_id_idx")
  @@map("email_tokens")
}

model RoleBinding {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId])
  @@index([userId], map: "role_bindings_user_id_idx")
  @@index([organizationId], map: "role_bindings_organization_id_idx")
  @@map("role_bindings")
}

model Branch {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  code           String?
  addressLine1   String?  @map("address_line1")
  addressLine2   String?  @map("address_line2")
  city           String?
  region         String?
  postalCode     String?  @map("postal_code")
  country        String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments  Department[]
  memberships  Membership[]
  invitations  Invitation[]

  @@index([organizationId], map: "branches_organization_id_idx")
  @@map("branches")
}

model Department {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  name           String
  code           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  memberships  Membership[]
  invitations  Invitation[]

  @@index([organizationId], map: "departments_organization_id_idx")
  @@index([branchId], map: "departments_branch_id_idx")
  @@map("departments")
}

model Membership {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  departmentId   String?  @map("department_id") @db.Uuid
  title          String?
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId], map: "memberships_organization_id_idx")
  @@index([userId], map: "memberships_user_id_idx")
  @@map("memberships")
}

model Invitation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  roleKey        String    @map("role_key")
  tokenHash      String    @map("token_hash")
  invitedBy      String?   @map("invited_by") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  departmentId   String?   @map("department_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User?        @relation("InvitationInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([email], map: "invitations_email_idx")
  @@index([organizationId], map: "invitations_organization_id_idx")
  @@index([tokenHash], map: "invitations_token_hash_idx")
  @@map("invitations")
}

model OrganizationBranding {
  organizationId String   @id @map("organization_id") @db.Uuid
  displayName    String?  @map("display_name")
  logoObjectKey  String?  @map("logo_object_key")
  primaryColor   String?  @map("primary_color")
  secondaryColor String?  @map("secondary_color")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_branding")
}

model BulkImportJob {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  createdBy            String?   @map("created_by") @db.Uuid
  sourceObjectKey      String    @map("source_object_key")
  errorReportObjectKey String?   @map("error_report_object_key")
  status               String    @default("pending")
  totalRows            Int       @default(0) @map("total_rows")
  successRows          Int       @default(0) @map("success_rows")
  failedRows           Int       @default(0) @map("failed_rows")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([organizationId], map: "bulk_import_jobs_organization_id_idx")
  @@map("bulk_import_jobs")
}

/// Wave 2 — Document management

model Document {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  createdById      String    @map("created_by_id") @db.Uuid
  title            String
  description      String?
  categoryId       String?   @map("category_id") @db.Uuid
  currentVersionId String?   @unique @map("current_version_id") @db.Uuid
  status           String    @default("pending_upload")
  /// private | organization | public | restricted
  visibility       String    @default("private")
  publicVerifyCode String?   @unique @map("public_verify_code")
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization                Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy                   User                          @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  category                    DocumentCategory?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  currentVersion              DocumentVersion?              @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions                    DocumentVersion[]             @relation("DocumentVersions")
  tags                        DocumentTagOnDocument[]
  shares                      DocumentShare[]
  accessPolicies              DocumentAccessPolicy[]
  auditEntries                DocumentAuditEntry[]
  uploadSessions              DocumentUploadSession[]
  blockchainTransactions      BlockchainTransaction[]
  blockchainAnchors           BlockchainAnchor[]
  verificationRequests        VerificationRequest[]
  verificationCaches          VerificationCache[]
  publicVerificationTokens    PublicVerificationToken[]
  publicVerificationLinks     PublicVerificationLink[]
  publicVerificationEvents    PublicVerificationEvent[]
  publicVerificationAnalytics PublicVerificationAnalytics[]
  documentQrCodes             DocumentQrCode[]
  qrVerificationEvents        QrVerificationEvent[]
  qrAnalytics                 QrAnalytics[]

  @@index([organizationId], map: "documents_organization_id_idx")
  @@index([status], map: "documents_status_idx")
  @@index([visibility], map: "documents_visibility_idx")
  @@index([publicVerifyCode], map: "documents_public_verify_code_idx")
  @@index([deletedAt], map: "documents_deleted_at_idx")
  @@index([expiresAt], map: "documents_expires_at_idx")
  @@map("documents")
}

model DocumentVersion {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId        String   @map("document_id") @db.Uuid
  versionNumber     Int      @map("version_number")
  objectKey         String   @map("object_key")
  contentHash       String   @map("content_hash")
  mimeType          String   @map("mime_type")
  sizeBytes         BigInt   @map("size_bytes")
  originalFileName  String   @map("original_file_name")
  uploadedById      String   @map("uploaded_by_id") @db.Uuid
  checksumAlgorithm String   @default("sha256") @map("checksum_algorithm")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document               Document                @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy             User                    @relation("DocumentVersionUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  currentFor             Document?               @relation("DocumentCurrentVersion")
  blockchainTransactions BlockchainTransaction[]
  blockchainAnchors      BlockchainAnchor[]
  verificationRequests   VerificationRequest[]

  @@unique([documentId, versionNumber], map: "document_versions_document_id_version_number_key")
  @@index([documentId], map: "document_versions_document_id_idx")
  @@index([contentHash], map: "document_versions_content_hash_idx")
  @@map("document_versions")
}

model DocumentCategory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    Document[]

  @@unique([organizationId, name], map: "document_categories_organization_id_name_key")
  @@index([organizationId], map: "document_categories_organization_id_idx")
  @@map("document_categories")
}

model DocumentTag {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    DocumentTagOnDocument[]

  @@unique([organizationId, name], map: "document_tags_organization_id_name_key")
  @@index([organizationId], map: "document_tags_organization_id_idx")
  @@map("document_tags")
}

model DocumentTagOnDocument {
  documentId String @map("document_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  document Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag      DocumentTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@map("document_tags_on_documents")
}

model DocumentShare {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId       String    @map("document_id") @db.Uuid
  sharedWithUserId String?   @map("shared_with_user_id") @db.Uuid
  sharedWithEmail  String?   @map("shared_with_email")
  permission       String
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdById      String    @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sharedWithUser User?    @relation("DocumentShareRecipient", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  createdBy      User     @relation("DocumentShareCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([documentId], map: "document_shares_document_id_idx")
  @@map("document_shares")
}

model DocumentAccessPolicy {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id")
  permission  String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, subjectType, subjectId, permission], map: "document_access_policies_unique")
  @@index([documentId], map: "document_access_policies_document_id_idx")
  @@map("document_access_policies")
}

model DocumentAuditEntry {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("DocumentAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([documentId], map: "document_audit_entries_document_id_idx")
  @@index([organizationId, createdAt], map: "document_audit_entries_organization_id_created_at_idx")
  @@map("document_audit_entries")
}

model DocumentUploadSession {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId        String    @map("document_id") @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  createdById       String    @map("created_by_id") @db.Uuid
  objectKey         String    @map("object_key")
  expectedMimeType  String    @map("expected_mime_type")
  expectedSizeBytes BigInt?   @map("expected_size_bytes")
  status            String    @default("pending")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("DocumentUploadSessionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([documentId], map: "document_upload_sessions_document_id_idx")
  @@index([organizationId], map: "document_upload_sessions_organization_id_idx")
  @@index([status], map: "document_upload_sessions_status_idx")
  @@index([expiresAt], map: "document_upload_sessions_expires_at_idx")
  @@map("document_upload_sessions")
}

/// Wave 3 — Blockchain integration (Hardhat + Sepolia only)

model BlockchainNetwork {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                     String   @unique
  chainId                 Int      @map("chain_id")
  name                    String
  rpcUrlHint              String?  @map("rpc_url_hint")
  explorerBaseUrl         String?  @map("explorer_base_url")
  documentRegistryAddress String?  @map("document_registry_address")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  transactions     BlockchainTransaction[]
  anchors          BlockchainAnchor[]
  events           BlockchainEvent[]
  retryJobs        BlockchainRetryJob[]
  orgRegistrations OrganizationChainRegistration[]
  intentNonces     BlockchainIntentNonce[]

  @@index([chainId], map: "blockchain_networks_chain_id_idx")
  @@map("blockchain_networks")
}

model BlockchainTransaction {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  networkId         String    @map("network_id") @db.Uuid
  organizationId    String?   @map("organization_id") @db.Uuid
  documentId        String?   @map("document_id") @db.Uuid
  documentVersionId String?   @map("document_version_id") @db.Uuid
  operation         String
  fromAddress       String    @map("from_address")
  toAddress         String    @map("to_address")
  nonce             Int?
  txHash            String?   @map("tx_hash")
  status            String    @default("pending")
  blockNumber       BigInt?   @map("block_number")
  blockHash         String?   @map("block_hash")
  transactionIndex  Int?      @map("transaction_index")
  confirmationCount Int       @default(0) @map("confirmation_count")
  gasLimit          BigInt?   @map("gas_limit")
  gasUsed           BigInt?   @map("gas_used")
  maxFeePerGas      BigInt?   @map("max_fee_per_gas")
  error             String?
  submittedAt       DateTime? @map("submitted_at") @db.Timestamptz(6)
  confirmedAt       DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  network          BlockchainNetwork               @relation(fields: [networkId], references: [id], onDelete: Cascade)
  organization     Organization?                   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  document         Document?                       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentVersion  DocumentVersion?                @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  anchorsAsAnchor  BlockchainAnchor[]              @relation("AnchorTx")
  anchorsAsRevoke  BlockchainAnchor[]              @relation("RevokeTx")
  orgRegistrations OrganizationChainRegistration[]

  @@unique([networkId, txHash], map: "blockchain_transactions_network_id_tx_hash_key")
  @@index([status], map: "blockchain_transactions_status_idx")
  @@index([organizationId], map: "blockchain_transactions_organization_id_idx")
  @@index([documentId], map: "blockchain_transactions_document_id_idx")
  @@map("blockchain_transactions")
}

model BlockchainAnchor {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  networkId         String    @map("network_id") @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  documentId        String    @map("document_id") @db.Uuid
  documentVersionId String    @map("document_version_id") @db.Uuid
  contentHash       String    @map("content_hash")
  versionNumber     Int       @map("version_number")
  orgIdBytes32      String    @map("org_id_bytes32")
  documentIdBytes32 String    @map("document_id_bytes32")
  status            String    @default("pending")
  blockNumber       BigInt?   @map("block_number")
  blockHash         String?   @map("block_hash")
  transactionIndex  Int?      @map("transaction_index")
  confirmationCount Int       @default(0) @map("confirmation_count")
  anchoredAt        DateTime? @map("anchored_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  failedAt          DateTime? @map("failed_at") @db.Timestamptz(6)
  failureReason     String?   @map("failure_reason")
  anchorTxId        String?   @map("anchor_tx_id") @db.Uuid
  revokeTxId        String?   @map("revoke_tx_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  network         BlockchainNetwork      @relation(fields: [networkId], references: [id], onDelete: Cascade)
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document        Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion        @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  anchorTx        BlockchainTransaction? @relation("AnchorTx", fields: [anchorTxId], references: [id], onDelete: SetNull)
  revokeTx        BlockchainTransaction? @relation("RevokeTx", fields: [revokeTxId], references: [id], onDelete: SetNull)

  @@unique([networkId, documentVersionId], map: "blockchain_anchors_network_id_document_version_id_key")
  @@index([contentHash], map: "blockchain_anchors_content_hash_idx")
  @@index([organizationId], map: "blockchain_anchors_organization_id_idx")
  @@index([status], map: "blockchain_anchors_status_idx")
  @@map("blockchain_anchors")
}

model BlockchainEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  networkId       String   @map("network_id") @db.Uuid
  contractAddress String   @map("contract_address")
  eventName       String   @map("event_name")
  blockNumber     BigInt   @map("block_number")
  logIndex        Int      @map("log_index")
  txHash          String   @map("tx_hash")
  payload         Json?
  processedAt     DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  network BlockchainNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@unique([networkId, txHash, logIndex], map: "blockchain_events_network_id_tx_hash_log_index_key")
  @@index([networkId, eventName], map: "blockchain_events_network_id_event_name_idx")
  @@map("blockchain_events")
}

model BlockchainRetryJob {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  networkId      String    @map("network_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  operation      String
  referenceType  String    @map("reference_type")
  referenceId    String    @map("reference_id") @db.Uuid
  payload        Json?
  status         String    @default("queued")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(8) @map("max_attempts")
  lastError      String?   @map("last_error")
  nextRunAt      DateTime  @default(now()) @map("next_run_at") @db.Timestamptz(6)
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  network      BlockchainNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)
  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status, nextRunAt], map: "blockchain_retry_jobs_status_next_run_at_idx")
  @@index([organizationId], map: "blockchain_retry_jobs_organization_id_idx")
  @@map("blockchain_retry_jobs")
}

model OrganizationChainRegistration {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  networkId      String    @map("network_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  ownerAddress   String    @map("owner_address")
  status         String    @default("pending")
  registerTxId   String?   @map("register_tx_id") @db.Uuid
  registeredAt   DateTime? @map("registered_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  network      BlockchainNetwork      @relation(fields: [networkId], references: [id], onDelete: Cascade)
  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registerTx   BlockchainTransaction? @relation(fields: [registerTxId], references: [id], onDelete: SetNull)

  @@unique([networkId, organizationId], map: "organization_chain_registrations_network_id_organization_id_key")
  @@map("organization_chain_registrations")
}

model BlockchainIntentNonce {
  organizationId String   @map("organization_id") @db.Uuid
  networkId      String   @map("network_id") @db.Uuid
  nextNonce      BigInt   @default(0) @map("next_nonce")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  network      BlockchainNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@id([organizationId, networkId])
  @@map("blockchain_intent_nonces")
}

/// Wave 4 — Verification engine

model VerificationRequest {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  verificationCode    String    @unique @map("verification_code")
  organizationId      String    @map("organization_id") @db.Uuid
  documentId          String    @map("document_id") @db.Uuid
  documentVersionId   String?   @map("document_version_id") @db.Uuid
  requestedByUserId   String    @map("requested_by_user_id") @db.Uuid
  mode                String    @default("sync")
  /// Internal: pending | processing | completed | failed
  status              String    @default("pending")
  idempotencyKey      String?   @map("idempotency_key")
  expectedContentHash String?   @map("expected_content_hash")
  options             Json?
  intentNonce         BigInt?   @map("intent_nonce")
  signature           String?
  startedAt           DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document        Document                 @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion?         @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  requestedBy     User                     @relation("VerificationRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  result          VerificationResult?
  auditEntries    VerificationAuditEntry[]
  caches          VerificationCache[]

  @@unique([organizationId, idempotencyKey], map: "verification_requests_organization_id_idempotency_key_key")
  @@index([organizationId, createdAt], map: "verification_requests_organization_id_created_at_idx")
  @@index([documentId, createdAt], map: "verification_requests_document_id_created_at_idx")
  @@index([status], map: "verification_requests_status_idx")
  @@index([verificationCode], map: "verification_requests_verification_code_idx")
  @@map("verification_requests")
}

model VerificationResult {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId        String    @unique @map("request_id") @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  /// External: valid | invalid | revoked | expired | missing | tampered
  outcome          String
  versionNumber    Int?      @map("version_number")
  contentHash      String?   @map("content_hash")
  blockchainStatus String?   @map("blockchain_status")
  revocationStatus String?   @map("revocation_status")
  proofOfIntegrity String?   @map("proof_of_integrity")
  proofTimestamp   DateTime? @map("proof_timestamp") @db.Timestamptz(6)
  networkName      String?   @map("network_name")
  transactionHash  String?   @map("transaction_hash")
  blockNumber      BigInt?   @map("block_number")
  checks           Json?
  failureReasons   Json?     @map("failure_reasons")
  report           Json
  verifiedAt       DateTime  @default(now()) @map("verified_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  request      VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  caches       VerificationCache[]

  @@index([organizationId, verifiedAt], map: "verification_results_organization_id_verified_at_idx")
  @@index([outcome], map: "verification_results_outcome_idx")
  @@map("verification_results")
}

model VerificationAuditEntry {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  request      VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?               @relation("VerificationAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([requestId], map: "verification_audit_entries_request_id_idx")
  @@index([organizationId, createdAt], map: "verification_audit_entries_organization_id_created_at_idx")
  @@map("verification_audit_entries")
}

model VerificationCache {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cacheKey       String   @unique @map("cache_key")
  organizationId String   @map("organization_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  requestId      String?  @map("request_id") @db.Uuid
  resultId       String?  @map("result_id") @db.Uuid
  outcome        String
  status         String
  report         Json
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  request      VerificationRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  result       VerificationResult?  @relation(fields: [resultId], references: [id], onDelete: SetNull)

  @@index([organizationId, documentId], map: "verification_caches_organization_id_document_id_idx")
  @@index([expiresAt], map: "verification_caches_expires_at_idx")
  @@map("verification_caches")
}

/// Wave 5 — Public verification layer

model PublicVerificationToken {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicCode            String    @unique @map("public_code")
  organizationId        String    @map("organization_id") @db.Uuid
  documentId            String?   @map("document_id") @db.Uuid
  documentVersionId     String?   @map("document_version_id") @db.Uuid
  verificationRequestId String?   @map("verification_request_id") @db.Uuid
  tokenHash             String    @unique @map("token_hash")
  purpose               String    @default("link")
  status                String    @default("active")
  visibility            String    @default("public")
  expiresAt             DateTime? @map("expires_at") @db.Timestamptz(6)
  maxUses               Int?      @map("max_uses")
  useCount              Int       @default(0) @map("use_count")
  allowRehash           Boolean   @default(false) @map("allow_rehash")
  requireAnchor         Boolean   @default(true) @map("require_anchor")
  createdByUserId       String    @map("created_by_user_id") @db.Uuid
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(6)
  disabledAt            DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document        Document?                 @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy       User                      @relation("PublicTokenCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  links           PublicVerificationLink[]
  events          PublicVerificationEvent[]
  documentQrCodes DocumentQrCode[]

  @@index([organizationId], map: "public_verification_tokens_organization_id_idx")
  @@index([status], map: "public_verification_tokens_status_idx")
  @@index([expiresAt], map: "public_verification_tokens_expires_at_idx")
  @@map("public_verification_tokens")
}

model PublicVerificationLink {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicCode      String    @unique @map("public_code")
  organizationId  String    @map("organization_id") @db.Uuid
  documentId      String    @map("document_id") @db.Uuid
  tokenId         String    @map("token_id") @db.Uuid
  status          String    @default("active")
  visibility      String    @default("public")
  label           String?
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  snapshotJson    Json?     @map("snapshot_json")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document        Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  token           PublicVerificationToken   @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  createdBy       User                      @relation("PublicLinkCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  events          PublicVerificationEvent[]
  documentQrCodes DocumentQrCode[]

  @@index([organizationId, documentId], map: "public_verification_links_organization_id_document_id_idx")
  @@index([status], map: "public_verification_links_status_idx")
  @@map("public_verification_links")
}

model PublicVerificationEvent {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String?  @map("organization_id") @db.Uuid
  documentId       String?  @map("document_id") @db.Uuid
  linkId           String?  @map("link_id") @db.Uuid
  tokenId          String?  @map("token_id") @db.Uuid
  verificationCode String?  @map("verification_code")
  publicVerifyCode String?  @map("public_verify_code")
  lookupType       String   @map("lookup_type")
  lookupValueHash  String   @map("lookup_value_hash")
  outcome          String?
  success          Boolean  @default(false)
  errorCode        String?  @map("error_code")
  ipHash           String?  @map("ip_hash")
  userAgentHash    String?  @map("user_agent_hash")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  document     Document?                @relation(fields: [documentId], references: [id], onDelete: SetNull)
  link         PublicVerificationLink?  @relation(fields: [linkId], references: [id], onDelete: SetNull)
  token        PublicVerificationToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt], map: "public_verification_events_organization_id_created_at_idx")
  @@index([lookupType, createdAt], map: "public_verification_events_lookup_type_created_at_idx")
  @@index([ipHash, createdAt], map: "public_verification_events_ip_hash_created_at_idx")
  @@map("public_verification_events")
}

model PublicVerificationAnalytics {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  documentId     String?  @map("document_id") @db.Uuid
  day            DateTime @db.Date
  totalLookups   Int      @default(0) @map("total_lookups")
  validCount     Int      @default(0) @map("valid_count")
  invalidCount   Int      @default(0) @map("invalid_count")
  revokedCount   Int      @default(0) @map("revoked_count")
  expiredCount   Int      @default(0) @map("expired_count")
  missingCount   Int      @default(0) @map("missing_count")
  tamperedCount  Int      @default(0) @map("tampered_count")
  errorCount     Int      @default(0) @map("error_count")
  blockedCount   Int      @default(0) @map("blocked_count")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document?    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, documentId, day], map: "public_verification_analytics_org_doc_day_key")
  @@map("public_verification_analytics")
}

model PublicAbuseBlock {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ipHash          String   @map("ip_hash")
  organizationId  String?  @map("organization_id") @db.Uuid
  reason          String
  strikeCount     Int      @default(1) @map("strike_count")
  blockedUntil    DateTime @map("blocked_until") @db.Timestamptz(6)
  reputationScore Int      @default(0) @map("reputation_score")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([ipHash, blockedUntil], map: "public_abuse_blocks_ip_hash_blocked_until_idx")
  @@map("public_abuse_blocks")
}

/// Wave 6 — QR generation & discovery (verification via Wave 5 only)

model QrTemplate {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicCode      String   @unique @map("public_code")
  organizationId  String   @map("organization_id") @db.Uuid
  name            String
  description     String?
  sizePx          Int      @default(512) @map("size_px")
  errorCorrection String   @default("M") @map("error_correction")
  foregroundColor String   @default("#000000") @map("foreground_color")
  backgroundColor String   @default("#FFFFFF") @map("background_color")
  logoObjectKey   String?  @map("logo_object_key")
  marginModules   Int      @default(4) @map("margin_modules")
  /// Print optimization (template subsystem)
  printPageSize   String   @default("A4") @map("print_page_size")
  printDpi        Int      @default(300) @map("print_dpi")
  printMarginMm   Float    @default(10) @map("print_margin_mm")
  printBleedMm    Float    @default(3) @map("print_bleed_mm")
  qrPerPage       Int      @default(1) @map("qr_per_page")
  isDefault       Boolean  @default(false) @map("is_default")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User             @relation("QrTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  qrCodes      DocumentQrCode[]

  @@index([organizationId], map: "qr_templates_organization_id_idx")
  @@map("qr_templates")
}

model DocumentQrCode {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicCode                String    @unique @map("public_code")
  organizationId            String    @map("organization_id") @db.Uuid
  documentId                String    @map("document_id") @db.Uuid
  publicVerificationTokenId String    @map("public_verification_token_id") @db.Uuid
  publicVerificationLinkId  String?   @map("public_verification_link_id") @db.Uuid
  templateId                String?   @map("template_id") @db.Uuid
  /// V1 | V2 | V3 format version
  formatVersion             String    @default("V1") @map("format_version")
  status                    String    @default("active")
  visibility                String    @default("restricted")
  payloadChecksum           String    @map("payload_checksum")
  payloadHash               String    @map("payload_hash")
  signatureVersion          String    @default("1") @map("signature_version")
  algorithm                 String    @default("HMAC-SHA256")
  payloadJson               Json      @map("payload_json")
  issuedAt                  DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt                 DateTime? @map("expires_at") @db.Timestamptz(6)
  rotatedFromId             String?   @map("rotated_from_id") @db.Uuid
  rotatedToId               String?   @map("rotated_to_id") @db.Uuid
  pngObjectKey              String?   @map("png_object_key")
  svgObjectKey              String?   @map("svg_object_key")
  createdByUserId           String    @map("created_by_user_id") @db.Uuid
  revokedAt                 DateTime? @map("revoked_at") @db.Timestamptz(6)
  disabledAt                DateTime? @map("disabled_at") @db.Timestamptz(6)
  rotatedAt                 DateTime? @map("rotated_at") @db.Timestamptz(6)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  token        PublicVerificationToken @relation(fields: [publicVerificationTokenId], references: [id], onDelete: Cascade)
  link         PublicVerificationLink? @relation(fields: [publicVerificationLinkId], references: [id], onDelete: SetNull)
  template     QrTemplate?             @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy    User                    @relation("DocumentQrCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  events       QrVerificationEvent[]

  @@index([organizationId, createdAt], map: "document_qr_codes_organization_id_created_at_idx")
  @@index([documentId, status], map: "document_qr_codes_document_id_status_idx")
  @@index([status], map: "document_qr_codes_status_idx")
  @@map("document_qr_codes")
}

model QrVerificationEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  documentId     String?  @map("document_id") @db.Uuid
  qrCodeId       String?  @map("qr_code_id") @db.Uuid
  qrPublicCode   String?  @map("qr_public_code")
  lookupType     String   @map("lookup_type")
  outcome        String?
  success        Boolean  @default(false)
  errorCode      String?  @map("error_code")
  ipHash         String?  @map("ip_hash")
  userAgentHash  String?  @map("user_agent_hash")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  document     Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  qrCode       DocumentQrCode? @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt], map: "qr_verification_events_organization_id_created_at_idx")
  @@index([qrCodeId], map: "qr_verification_events_qr_code_id_idx")
  @@map("qr_verification_events")
}

model QrAnalytics {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  documentId     String?  @map("document_id") @db.Uuid
  day            DateTime @db.Date
  scanCount      Int      @default(0) @map("scan_count")
  downloadCount  Int      @default(0) @map("download_count")
  validCount     Int      @default(0) @map("valid_count")
  invalidCount   Int      @default(0) @map("invalid_count")
  revokedCount   Int      @default(0) @map("revoked_count")
  expiredCount   Int      @default(0) @map("expired_count")
  errorCount     Int      @default(0) @map("error_count")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document?    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, documentId, day], map: "qr_analytics_org_doc_day_key")
  @@map("qr_analytics")
}

model QrBatchJob {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  operation       String
  status          String    @default("pending")
  total           Int       @default(0)
  successCount    Int       @default(0) @map("success_count")
  failedCount     Int       @default(0) @map("failed_count")
  formatVersion   String    @default("V1") @map("format_version")
  resultJson      Json?     @map("result_json")
  error           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)

  @@index([organizationId, createdAt], map: "qr_batch_jobs_organization_id_created_at_idx")
  @@map("qr_batch_jobs")
}
