generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Wave 1 identity & organization schema.
/// Column and table names preserve the existing PostgreSQL shape via @map / @@map.

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String
  passwordHash    String    @map("password_hash")
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  status          String    @default("active")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  devices                  Device[]
  sessions                 Session[]
  mfaFactors               MfaFactor[]
  emailTokens              EmailToken[]
  roleBindings             RoleBinding[]
  memberships              Membership[]
  invitationsSent          Invitation[]            @relation("InvitationInvitedBy")
  bulkImportJobs           BulkImportJob[]
  mfaLoginChallenges       MfaLoginChallenge[]
  documentsCreated         Document[]              @relation("DocumentCreatedBy")
  documentVersionsUploaded DocumentVersion[]       @relation("DocumentVersionUploadedBy")
  documentSharesCreated    DocumentShare[]         @relation("DocumentShareCreatedBy")
  documentSharesReceived   DocumentShare[]         @relation("DocumentShareRecipient")
  documentAuditEntries     DocumentAuditEntry[]    @relation("DocumentAuditActor")
  documentUploadSessions   DocumentUploadSession[] @relation("DocumentUploadSessionCreator")

  @@index([email], map: "users_email_idx")
  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roleBindings RoleBinding[]

  @@map("roles")
}

model Organization {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  slug                 String
  parentOrganizationId String?  @map("parent_organization_id") @db.Uuid
  status               String   @default("active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent                 Organization?           @relation("OrgHierarchy", fields: [parentOrganizationId], references: [id], onDelete: SetNull)
  children               Organization[]          @relation("OrgHierarchy")
  branches               Branch[]
  departments            Department[]
  memberships            Membership[]
  invitations            Invitation[]
  roleBindings           RoleBinding[]
  branding               OrganizationBranding?
  bulkImports            BulkImportJob[]
  documents              Document[]
  documentCategories     DocumentCategory[]
  documentTags           DocumentTag[]
  documentAuditEntries   DocumentAuditEntry[]
  documentUploadSessions DocumentUploadSession[]

  @@unique([slug], map: "organizations_slug_unique_idx")
  @@index([slug], map: "organizations_slug_idx")
  @@index([parentOrganizationId], map: "organizations_parent_idx")
  @@map("organizations")
}

model Device {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String?
  fingerprint String?
  userAgent   String?   @map("user_agent")
  trusted     Boolean   @default(false)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([userId], map: "devices_user_id_idx")
  @@map("devices")
}

model Session {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  deviceId         String?              @map("device_id") @db.Uuid
  refreshTokenHash String               @map("refresh_token_hash")
  ip               Unsupported("inet")?
  userAgent        String?              @map("user_agent")
  expiresAt        DateTime             @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?            @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId], map: "sessions_user_id_idx")
  @@index([refreshTokenHash], map: "sessions_refresh_token_hash_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model MfaFactor {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  type            String    @default("totp")
  secretEncrypted String    @map("secret_encrypted")
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz(6)
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "mfa_factors_user_id_idx")
  @@map("mfa_factors")
}

model MfaLoginChallenge {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash], map: "mfa_login_challenges_token_hash_idx")
  @@index([userId], map: "mfa_login_challenges_user_id_idx")
  @@map("mfa_login_challenges")
}

model EmailToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  purpose   String
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash], map: "email_tokens_token_hash_idx")
  @@index([userId], map: "email_tokens_user_id_idx")
  @@map("email_tokens")
}

model RoleBinding {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId])
  @@index([userId], map: "role_bindings_user_id_idx")
  @@index([organizationId], map: "role_bindings_organization_id_idx")
  @@map("role_bindings")
}

model Branch {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  code           String?
  addressLine1   String?  @map("address_line1")
  addressLine2   String?  @map("address_line2")
  city           String?
  region         String?
  postalCode     String?  @map("postal_code")
  country        String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments  Department[]
  memberships  Membership[]
  invitations  Invitation[]

  @@index([organizationId], map: "branches_organization_id_idx")
  @@map("branches")
}

model Department {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  name           String
  code           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  memberships  Membership[]
  invitations  Invitation[]

  @@index([organizationId], map: "departments_organization_id_idx")
  @@index([branchId], map: "departments_branch_id_idx")
  @@map("departments")
}

model Membership {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  departmentId   String?  @map("department_id") @db.Uuid
  title          String?
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId], map: "memberships_organization_id_idx")
  @@index([userId], map: "memberships_user_id_idx")
  @@map("memberships")
}

model Invitation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  roleKey        String    @map("role_key")
  tokenHash      String    @map("token_hash")
  invitedBy      String?   @map("invited_by") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  departmentId   String?   @map("department_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User?        @relation("InvitationInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([email], map: "invitations_email_idx")
  @@index([organizationId], map: "invitations_organization_id_idx")
  @@index([tokenHash], map: "invitations_token_hash_idx")
  @@map("invitations")
}

model OrganizationBranding {
  organizationId String   @id @map("organization_id") @db.Uuid
  displayName    String?  @map("display_name")
  logoObjectKey  String?  @map("logo_object_key")
  primaryColor   String?  @map("primary_color")
  secondaryColor String?  @map("secondary_color")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_branding")
}

model BulkImportJob {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  createdBy            String?   @map("created_by") @db.Uuid
  sourceObjectKey      String    @map("source_object_key")
  errorReportObjectKey String?   @map("error_report_object_key")
  status               String    @default("pending")
  totalRows            Int       @default(0) @map("total_rows")
  successRows          Int       @default(0) @map("success_rows")
  failedRows           Int       @default(0) @map("failed_rows")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([organizationId], map: "bulk_import_jobs_organization_id_idx")
  @@map("bulk_import_jobs")
}

/// Wave 2 — Document management

model Document {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  createdById      String    @map("created_by_id") @db.Uuid
  title            String
  description      String?
  categoryId       String?   @map("category_id") @db.Uuid
  currentVersionId String?   @unique @map("current_version_id") @db.Uuid
  status           String    @default("pending_upload")
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User                    @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  category       DocumentCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  currentVersion DocumentVersion?        @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       DocumentVersion[]       @relation("DocumentVersions")
  tags           DocumentTagOnDocument[]
  shares         DocumentShare[]
  accessPolicies DocumentAccessPolicy[]
  auditEntries   DocumentAuditEntry[]
  uploadSessions DocumentUploadSession[]

  @@index([organizationId], map: "documents_organization_id_idx")
  @@index([status], map: "documents_status_idx")
  @@index([deletedAt], map: "documents_deleted_at_idx")
  @@index([expiresAt], map: "documents_expires_at_idx")
  @@map("documents")
}

model DocumentVersion {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId        String   @map("document_id") @db.Uuid
  versionNumber     Int      @map("version_number")
  objectKey         String   @map("object_key")
  contentHash       String   @map("content_hash")
  mimeType          String   @map("mime_type")
  sizeBytes         BigInt   @map("size_bytes")
  originalFileName  String   @map("original_file_name")
  uploadedById      String   @map("uploaded_by_id") @db.Uuid
  checksumAlgorithm String   @default("sha256") @map("checksum_algorithm")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document   Document  @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation("DocumentVersionUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  currentFor Document? @relation("DocumentCurrentVersion")

  @@unique([documentId, versionNumber], map: "document_versions_document_id_version_number_key")
  @@index([documentId], map: "document_versions_document_id_idx")
  @@index([contentHash], map: "document_versions_content_hash_idx")
  @@map("document_versions")
}

model DocumentCategory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    Document[]

  @@unique([organizationId, name], map: "document_categories_organization_id_name_key")
  @@index([organizationId], map: "document_categories_organization_id_idx")
  @@map("document_categories")
}

model DocumentTag {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    DocumentTagOnDocument[]

  @@unique([organizationId, name], map: "document_tags_organization_id_name_key")
  @@index([organizationId], map: "document_tags_organization_id_idx")
  @@map("document_tags")
}

model DocumentTagOnDocument {
  documentId String @map("document_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  document Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag      DocumentTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@map("document_tags_on_documents")
}

model DocumentShare {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId       String    @map("document_id") @db.Uuid
  sharedWithUserId String?   @map("shared_with_user_id") @db.Uuid
  sharedWithEmail  String?   @map("shared_with_email")
  permission       String
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdById      String    @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sharedWithUser User?    @relation("DocumentShareRecipient", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  createdBy      User     @relation("DocumentShareCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([documentId], map: "document_shares_document_id_idx")
  @@map("document_shares")
}

model DocumentAccessPolicy {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id")
  permission  String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, subjectType, subjectId, permission], map: "document_access_policies_unique")
  @@index([documentId], map: "document_access_policies_document_id_idx")
  @@map("document_access_policies")
}

model DocumentAuditEntry {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("DocumentAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([documentId], map: "document_audit_entries_document_id_idx")
  @@index([organizationId, createdAt], map: "document_audit_entries_organization_id_created_at_idx")
  @@map("document_audit_entries")
}

model DocumentUploadSession {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId        String    @map("document_id") @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  createdById       String    @map("created_by_id") @db.Uuid
  objectKey         String    @map("object_key")
  expectedMimeType  String    @map("expected_mime_type")
  expectedSizeBytes BigInt?   @map("expected_size_bytes")
  status            String    @default("pending")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("DocumentUploadSessionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([documentId], map: "document_upload_sessions_document_id_idx")
  @@index([organizationId], map: "document_upload_sessions_organization_id_idx")
  @@index([status], map: "document_upload_sessions_status_idx")
  @@index([expiresAt], map: "document_upload_sessions_expires_at_idx")
  @@map("document_upload_sessions")
}
