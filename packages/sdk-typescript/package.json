{
  "name": "@trustchain/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Official TrustChain TypeScript / JavaScript SDK for the public developer API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  }
}
