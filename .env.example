# TrustChain — root environment (copy to .env)
NODE_ENV=development

# PostgreSQL (local or managed instance — no Docker Compose in this repo)
DATABASE_URL=postgresql://trustchain:trustchain@localhost:5432/trustchain

# Backend
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Redis (optional — never store permanent data)
# REDIS_URL=redis://localhost:6379

# Cloudflare R2 (object storage for uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=trustchain
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto

# Email — Mailtrap or Gmail SMTP
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@trustchain.local
# Example Gmail SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Blockchain (local Hardhat node)
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_NETWORK=localhost
CHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
