# TrustChain — root environment (copy to .env)
NODE_ENV=development

# PostgreSQL (local or managed instance — no Docker Compose in this repo)
DATABASE_URL=postgresql://trustchain:trustchain@localhost:5432/trustchain

# Backend
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Redis (optional — rate limits / AI queues / locks / messaging hot cache; never the source of truth)
# REDIS_URL=redis://127.0.0.1:6379

# Optional AI execution service (Phase 2 gateway). When unset, Express uses an in-memory execution client for CI/local.
# AI_SERVICE_URL=http://127.0.0.1:8090
# AI_SERVICE_TOKEN=
# AI_EXECUTION_DRAIN=true

# Auth / secrets (required at backend startup)
JWT_ACCESS_SECRET=dev-jwt-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Document envelope encryption (AES-256-GCM). Prefer 64-char hex KEKs.
DOCUMENT_ENCRYPTION_ENABLED=true
DOCUMENT_ACTIVE_KEY_VERSION=1
DOCUMENT_KEY_V1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# DOCUMENT_KEY_V2=
# DOCUMENT_KEY_V3=

# Malware scanner: mock | http | clamav
MALWARE_SCANNER=mock
# MALWARE_SCAN_URL=http://localhost:8088/scan
# MALWARE_CLAMD_HOST=127.0.0.1
# MALWARE_CLAMD_PORT=3310

# Backblaze B2 (S3-compatible object storage for uploads). First 10 GB free.
# Create a bucket + application key at https://secure.backblaze.com/b2_buckets.htm
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=trustchain
B2_REGION=us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# Email — Mailtrap or Gmail SMTP
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@trustchain.local
# Example Gmail SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Blockchain — Wave 3 supports Hardhat and Sepolia only
CHAIN_ENABLED=true
CHAIN_NETWORK=hardhat
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CHAIN_DOCUMENT_REGISTRY_ADDRESS=
CHAIN_CONFIRMATIONS=1
# Local file store when R2 credentials are empty (issue/verify still persist PDFs)
# OBJECT_STORAGE_DIR=.data/object-storage
PUBLIC_VERIFY_BASE_URL=https://verify.trustchain.com
PUBLIC_VERIFY_SIGNING_SECRET=dev-public-verify-signing-secret-change-me

# Razorpay (https://dashboard.razorpay.com/app/keys). Test keys start with rzp_test_.
# When KEY_ID and KEY_SECRET are set, checkout uses Razorpay Checkout.js (mock is ignored).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
# Webhook URL: POST /api/v1/billing/webhooks/razorpay  (events: payment.captured, order.paid, payment.failed)
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MOCK=false

# Firebase Auth (Admin SDK). Register stores the password in Firebase and Postgres.
# The 6-digit OTP email is sent by Firebase (not SMTP). Set the Web API key from Project settings.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_WEB_API_KEY=
# CHAIN_NETWORK=sepolia
# CHAIN_RPC_URL=https://rpc.sepolia.org
# CHAIN_DOCUMENT_REGISTRY_ADDRESS=0x...
