# TrustChain — root local environment (copy to .env)
NODE_ENV=development

# PostgreSQL (Docker Compose)
POSTGRES_USER=trustchain
POSTGRES_PASSWORD=trustchain
POSTGRES_DB=trustchain
DATABASE_URL=postgresql://trustchain:trustchain@localhost:5432/trustchain

# Backend
PORT=3000
CORS_ORIGIN=http://localhost:5173

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=trustchain
MINIO_USE_SSL=false

# Mailhog (local SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025

# Blockchain (local Hardhat node)
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_NETWORK=localhost
# Local Hardhat account #0 — DO NOT use outside local development
CHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
