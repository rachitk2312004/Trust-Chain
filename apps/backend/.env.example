NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Process notification email outbox (enable only when testing email delivery)
NOTIFICATION_WORKER_ENABLED=false

# Detailed request timing: auth/db/query breakdown (development)
# PERF_LOG=1

# Prisma pool cap when using remote PostgreSQL (default 5 if unset in DATABASE_URL)
# DATABASE_CONNECTION_LIMIT=5

# Redis (optional — rate limits, queues, and messaging hot cache; Postgres stays the store)
REDIS_URL=redis://127.0.0.1:6379

# Backblaze B2 (S3-compatible). First 10 GB is free. Create an application key with
# read/write to one bucket. Endpoint looks like https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=trustchain
B2_REGION=us-west-004
# Must include https:// — bare hosts break the AWS SDK with Invalid URL.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_ACCOUNT_ID=

# Email — Mailtrap or Gmail SMTP
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@trustchain.local

CHAIN_ENABLED=true
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_NETWORK=hardhat
CHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CHAIN_DOCUMENT_REGISTRY_ADDRESS=
CHAIN_CONFIRMATIONS=1
PUBLIC_VERIFY_BASE_URL=https://verify.trustchain.com
PUBLIC_VERIFY_SIGNING_SECRET=dev-public-verify-signing-secret-change-me

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Document envelope encryption
DOCUMENT_ENCRYPTION_ENABLED=true
DOCUMENT_ACTIVE_KEY_VERSION=1
DOCUMENT_KEY_V1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# DOCUMENT_KEY_V2=
# DOCUMENT_KEY_V3=

# Malware: mock | http | clamav
MALWARE_SCANNER=mock
# MALWARE_SCAN_URL=
# MALWARE_CLAMD_HOST=127.0.0.1
# MALWARE_CLAMD_PORT=3310

# Phase 2 AI execution gateway (optional). Unset → in-memory client for local/CI.
# AI_SERVICE_URL=http://127.0.0.1:8090
# AI_SERVICE_TOKEN=
# AI_EXECUTION_DRAIN=true

# Bind this email as platform super_admin on register, login, and API startup
# SUPER_ADMIN_EMAIL=admin@example.com

# Razorpay billing. Test keys (rzp_test_...) enable live Checkout.js; mock is used only when keys are missing.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
# Webhook: POST /api/v1/billing/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MOCK=false

# Firebase Auth Admin — password is stored in Firebase and Postgres.
# Verification emails are sent by Firebase (Google mail), not Railway SMTP.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Web API key from Firebase Console → Project settings → General (used to send the OTP email)
# FIREBASE_WEB_API_KEY=
# Add your Vercel domain under Authentication → Settings → Authorized domains
# PUBLIC_APP_URL=https://your-app.vercel.app
