{
  "expo": {
    "name": "TrustChain",
    "slug": "trustchain",
    "version": "0.8.0",
    "orientation": "portrait",
    "scheme": "trustchain",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trustchain.app",
      "infoPlist": {
        "NSCameraUsageDescription": "TrustChain needs the camera to scan verification QR codes.",
        "NSFaceIDUsageDescription": "Unlock your TrustChain session"
      }
    },
    "android": {
      "package": "com.trustchain.app",
      "permissions": ["CAMERA", "USE_BIOMETRIC", "USE_FINGERPRINT"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TrustChain to scan QR codes for document verification."
        }
      ],
      "expo-local-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
